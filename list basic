#to do list app

tasks = []
while True : #  infinite loop
    print("\n -- To Do List --")
    print("1. Add a task")
    print("2. View tasks")
    print("3. Remove a task")
    print("4. Exit")

    choice = int(input('\nChoose an option (1-4): '))

    if choice == 1:
        task = input("Enter the task to add:")
        tasks.append(task)
        print("Task" + task + "added!")

    elif choice == 2:
        for i in tasks:
            print(i)
    elif choice == 3:
        task = input("Enter the name of task you want to remove:")
        tasks.remove(task)
        print("task " + task + " removed!")

    elif choice == 4:
        print("Exiting To-Do List App. Goodbey!")
        break
