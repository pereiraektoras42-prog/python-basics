dictionary = {}
while True:
    print("\nMini Dictionary App\n")
    print("1. Add/Update a word")
    print("2. Retrieve a word's defenion")
    print("3. Delete a word")
    print("4. View all words")
    print("5. Exit")

    choice = input("Choose an option(1-5):")
    if choice == "1":
        word = input("Enter a word:").strip()
        definition = input("Enter the definition:")
        dictionary[word] = definition
        print(f"Word '{word}' added/updated sucessfully!")
          
    elif choice == "2":
        word = input("Enter a word to retrieve its definition:").strip()
        if word in dictionary:
            print(f"Definition of '{word}': {dictionary[word]}")
        else:
            print(f"Word '{word}' not found in the dictionary.")
    elif choice == "3":
        word = input("Enter a word to delete:").strip()
        if word in dictionary:
            del dictionary[word]
            print(f"Word '{word}' deleted successfully!")
        else:
            print(f"Word '{word}' not found in the dictionary.")
    elif choice == "4":
        if dictionary:
            print("Words in the dictionary:")
            for word, definition in dictionary.items():
                print(f"{word}: {definition}")
        else:
            print("The dictionary is empty.")
    elif choice == "5":
        print("Exiting the Mini Dictionary App. Goodbye!")
        break
    else:
        print("Invalid choice. Please choose a valid option (1-5).")
